# 示例不含可用凭证。项目开发脚本从 .work/postgres 读取随机生成的本机配置。
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4318
# 反向代理后的公开 HTTPS 地址，用于短期媒体和导出链接。
PUBLIC_BASE_URL=http://127.0.0.1:4318
DATABASE_URL=postgresql://babyplan:CHANGE_ME@127.0.0.1:56432/babyplan_dev
DB_POOL_MAX=8
# 私有对象目录，不放入网页静态目录；生产环境应挂载受限卷。
MEDIA_ROOT=.work/media
# 账号恢复令牌的私有投递目录。必须独立于备份目录并限制为维护者账户可读。
RECOVERY_OUTBOX_ROOT=.work/account-recovery-outbox
LOG_LEVEL=info
# 仅供一次性部署引导命令使用，不要提交真实值。
BABYPLAN_INITIAL_CREDENTIAL=
