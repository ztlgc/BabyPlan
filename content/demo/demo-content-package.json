      "title": "演示｜小手拍拍",
      "ageBands": ["m18_23"],
      "domains": ["song-rhythm", "zh-words", "daily-english", "quantity", "movement"],
      "materials": [],
      "steps": ["面对面坐，家长轻拍自己的手。", "停一停，看看宝宝想不想接着玩。"],
      "dialogue": {
        "opening": "这是我的手。你看，我拍一下——啪！",
        "whenJoins": "你也拍啦！还想再来吗？",
        "whenWatches": "你在看我的手。我再拍一次给你看。",
        "whenStops": "好，我们拍拍手玩完啦。"
      },
      "keywordsZh": ["手", "拍"],
      "english": {
        "words": [{ "word": "clap", "meaningZh": "拍手" }, { "word": "hands", "meaningZh": "手" }],
        "lines": [{ "line": "Let’s clap our hands!", "meaningZh": "我们一起拍拍手吧！", "when": "家长示范拍手时" }]
      },
      "song": {
        "title": "如果感到幸福你就拍拍手",
        "cue": "选熟悉的拍手段。哼一小段后，拍一拍，停一停。",
        "originalChant": "小手伸出来，轻轻拍一下。停一停，等一等，想玩再来呀！"
      },
      "numberPlay": { "concept": "1（一下）", "action": "边说「一」边拍一下，再停住。", "adultLine": "一，拍了一下。" },
      "variation": "下次可以等宝宝先动，家长跟着做。",
      "safety": "家长拍自己的手，宝宝想停就停。",
      "sources": [{ "title": "Head Start：在音乐和动作里玩数感", "url": "https://headstart.gov/teaching-practices/play-head-start-way/1-2-3-dance-me" }]
