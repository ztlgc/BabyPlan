  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:babyplan:content-package:2",
  "title": "BabyPlan v2 内容包：候选、私人试用与公开发布",
  "allOf": [
    {
      "if": {
        "properties": {
          "channel": {
            "const": "release"
          }
        },
        "required": [
          "channel"
        ]
      },
      "then": {
        "required": [
          "publicationEnvironment",
          "evidenceRefs"
        ],
        "properties": {
          "review": {
            "properties": {
              "editorial": {
                "const": "approved"
              }
            }
          },
          "cards": {
            "items": {
              "properties": {
                "reviewState": {
                  "const": "reviewed"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "channel": {
            "const": "release"
          },
          "publicationEnvironment": {
            "const": "public"
          }
        },
        "required": [
          "channel",
          "publicationEnvironment"
        ]
      },
      "then": {
        "properties": {
          "review": {
            "properties": {
              "familyTrial": {
                "const": "completed"
              }
            }
          }
        }
      }
    }
  ],
  "description": "Schema只验证结构；发布端必须核对可信证据注册表、具体正文hash和真实审读者。私人试用允许如实自审，不要求开始试玩前已经完成试玩。声明专业审阅或试玩完成必须有证据。"
