# 仅示例。实际文件放在仓库外的私有部署目录，不要提交。
# NODE_ENV=production 不强制 HTTPS；网页 Cookie 的 Secure 属性跟随 PUBLIC_BASE_URL。
NODE_ENV=development
CONTENT_ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=4318
PUBLIC_BASE_URL=http://192.168.5.196:4318
DB_POOL_MAX=6
LOG_LEVEL=info
MEDIA_ROOT=/data/media
RECOVERY_OUTBOX_ROOT=/data/recovery-outbox
DELETION_JOURNAL_ROOT=/data/deletion-journal
BACKUP_ROOT=/data/backups
RESTORE_ROOT=/data/restores
