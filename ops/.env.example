# 仅示例。请使用 scripts/ops/Initialize-BabyPlanEnvironment.ps1 生成并保护实际配置。
# PUBLIC_BASE_URL 使用 HTTPS 时网页 Cookie 自动带 Secure；HTTP 地址仅用于可信局域网。
NODE_ENV=production
CONTENT_ENVIRONMENT=private_trial
API_HOST=127.0.0.1
API_PORT=4318
PUBLIC_BASE_URL=http://127.0.0.1:4174
DATABASE_URL=postgresql://babyplan:REPLACE_WITH_STRONG_RANDOM_PASSWORD@127.0.0.1:5432/babyplan
DB_POOL_MAX=8
LOG_LEVEL=info
BABYPLAN_INITIAL_CREDENTIAL=
MEDIA_ROOT=E:/BabyPlan/private/data/media
MEDIA_STORAGE_PATH=E:/BabyPlan/private/data/media
BACKUP_ROOT=E:/BabyPlan/private/data/backups
RESTORE_ROOT=E:/BabyPlan/private/data/restores
RECOVERY_OUTBOX_ROOT=E:/BabyPlan/private/data/recovery-outbox
DELETION_JOURNAL_ROOT=E:/BabyPlan/private/data/deletion-journal
BABYPLAN_API_BASE_URL=http://127.0.0.1:4318
WEB_HOST=127.0.0.1
WEB_PORT=4174
BABYPLAN_API_TARGET=http://127.0.0.1:4318
